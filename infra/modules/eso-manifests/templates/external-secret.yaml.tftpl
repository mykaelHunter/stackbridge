apiVersion: external-secrets.io/v1
kind: ExternalSecret

metadata:
  name: ${service_name}-db-secret
  namespace: ${namespace}

spec:
  refreshInterval: 1h

  secretStoreRef:
    name: ${service_name}-secret-store
    kind: SecretStore

  target:
    name: ${service_name}-db-secret
    creationPolicy: Owner

  # Remote key matches aws_secretsmanager_secret.db_password.name in
  # modules/database/main.tf ("stackbridge/$${environment}/db-password").
  # `property` pulls a single field out of that secret's JSON body
  # (written by aws_secretsmanager_secret_version.db_password —
  # username/password/host/port/dbname).
  data:
  - secretKey: DB_PASS
    remoteRef:
      key: stackbridge/${environment}/db-password
      property: password
  - secretKey: DB_HOST
    remoteRef:
      key: stackbridge/${environment}/db-password
      property: host
  - secretKey: DB_PORT
    remoteRef:
      key: stackbridge/${environment}/db-password
      property: port
  - secretKey: DB_USER
    remoteRef:
      key: stackbridge/${environment}/db-password
      property: username
  - secretKey: DB_NAME
    remoteRef:
      key: stackbridge/${environment}/db-password
      property: dbname
