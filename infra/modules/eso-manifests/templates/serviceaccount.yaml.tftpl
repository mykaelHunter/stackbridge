apiVersion: v1
kind: ServiceAccount

metadata:
  name: ${service_name}-eso-sa

  annotations:
    # Written by Terraform (modules/eso-manifests) directly from the
    # external_secrets_role_arn output of modules/eks — never edited
    # by hand and never left as a template placeholder. The IAM trust
    # policy on that role is conditioned on this exact namespace +
    # ServiceAccount name; if you rename either, update
    # external_secrets_service_account / external_secrets_namespace
    # on the eks module call for this environment too.
    eks.amazonaws.com/role-arn: ${role_arn}
