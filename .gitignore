# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.env

# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.tfvars

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log

# Plans
tfplan
*.plan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Docker
.dockerignore

# Terraform plan artifacts — never commit these
*.binary
tfplan.json
tfplan.binary

# Ignore platform artifacts
stackbridge_platform.egg-info/

# Prevent template files leaking to repo root
# They belong in stackbridge/templates/ only
/*.tpl

# Prevent Terraform provider cache from being committed
# (was 700MB+ when it slipped in during a previous session)
**/.terraform/providers/

# Conftest installs its own LICENSE file when run locally
infra/environments/*/LICENSE
