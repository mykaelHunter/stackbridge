{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackBridge Service Catalogue Entry",
  "description": "Schema for a service registered in the StackBridge internal developer platform. Every service must have a complete entry before it can be deployed to staging or production.",
  "type": "object",
  "required": [
    "name",
    "id",
    "description",
    "owner",
    "tier",
    "language",
    "repository",
    "environments",
    "slo",
    "health_endpoint",
    "runbook_url",
    "on_call",
    "dependencies",
    "last_updated"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable service name",
      "examples": ["Orders API", "User Service"]
    },
    "id": {
      "type": "string",
      "description": "Unique identifier. Lowercase, hyphen-separated. Used as a key in tooling.",
      "pattern": "^[a-z][a-z0-9-]+$",
      "examples": ["orders-api", "user-service"]
    },
    "description": {
      "type": "string",
      "description": "One-sentence description of what this service does and who uses it."
    },
    "owner": {
      "type": "object",
      "required": ["team", "slack_channel", "email"],
      "properties": {
        "team": {
          "type": "string",
          "description": "Team name responsible for this service"
        },
        "slack_channel": {
          "type": "string",
          "description": "Primary Slack channel for this team",
          "pattern": "^#"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "tier": {
      "type": "string",
      "description": "Service criticality tier. Affects on-call priority and SLO targets.",
      "enum": ["tier-1", "tier-2", "tier-3"],
      "enumDescriptions": [
        "tier-1: Customer-facing, revenue-impacting",
        "tier-2: Internal, affects product teams",
        "tier-3: Background jobs, tooling, non-critical"
      ]
    },
    "language": {
      "type": "string",
      "examples": ["Python", "Go", "Node.js"]
    },
    "repository": {
      "type": "string",
      "description": "Full GitHub repository URL",
      "format": "uri"
    },
    "environments": {
      "type": "object",
      "description": "Per-environment deployment details",
      "properties": {
        "dev": { "$ref": "#/$defs/environment_entry" },
        "staging": { "$ref": "#/$defs/environment_entry" },
        "prod": { "$ref": "#/$defs/environment_entry" }
      }
    },
    "slo": {
      "type": "object",
      "description": "Service Level Objectives. The platform enforces these via Prometheus alerting rules.",
      "required": ["availability_target_pct", "latency_p95_ms", "error_rate_threshold_pct"],
      "properties": {
        "availability_target_pct": {
          "type": "number",
          "description": "Target availability as a percentage (e.g. 99.9)",
          "minimum": 0,
          "maximum": 100
        },
        "latency_p95_ms": {
          "type": "integer",
          "description": "p95 latency target in milliseconds"
        },
        "error_rate_threshold_pct": {
          "type": "number",
          "description": "Maximum acceptable error rate as a percentage"
        },
        "error_budget_policy": {
          "type": "string",
          "description": "What happens when the error budget is exhausted"
        }
      }
    },
    "health_endpoint": {
      "type": "string",
      "description": "Path to the health check endpoint. Must return 200 when healthy.",
      "examples": ["/health", "/api/v1/health"]
    },
    "runbook_url": {
      "type": "string",
      "description": "URL to the operational runbook for this service. Must be accessible to on-call.",
      "format": "uri"
    },
    "on_call": {
      "type": "object",
      "required": ["rotation", "escalation_path"],
      "properties": {
        "rotation": {
          "type": "string",
          "description": "PagerDuty rotation name or equivalent"
        },
        "escalation_path": {
          "type": "array",
          "description": "Ordered list of escalation contacts",
          "items": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "List of service IDs this service depends on. Used for incident blast radius analysis.",
      "items": { "type": "string" }
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 date when this catalogue entry was last verified",
      "format": "date"
    }
  },
  "$defs": {
    "environment_entry": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "deployed_version": { "type": "string" },
        "last_deployed": { "type": "string", "format": "date-time" }
      }
    }
  }
}
